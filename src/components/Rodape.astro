---
// Rodapé: só as palavras dos links (Home, Galeria, Avaliações, Como chegar, Contato) em Syne.
// Cores invertidas: fundo azul oficial (#1F4E6B) e texto na cor base do site (#F1F9F9).
const links = [
  { href: '/', texto: 'Home' },
  { href: '/galeria', texto: 'Galeria' },
  { href: '/avaliacoes', texto: 'Avaliações' },
  { href: '/como-chegar', texto: 'Como chegar' },
  { href: '/contato', texto: 'Contato' },
];
const atual = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<footer class="rodape escuro">
  <nav aria-label="Mais do Boni">
    <ul>
      {links.map((l) => (
        <li>
          <a class="rodape__link display" href={l.href} aria-current={atual === l.href ? 'page' : undefined}>{l.texto}</a>
        </li>
      ))}
    </ul>
  </nav>
</footer>

<style>
  .rodape { background: var(--color-texto); color: var(--color-base); padding: 48px var(--gutter) 64px; }
  .rodape ul { display: grid; gap: 0; }
  .rodape ul { list-style: none; margin: 0; padding: 0; }
  /* tamanho contido: de 16px (celular) a 36px (desktop) */
  .rodape__link {
    display: inline-block; padding: 16px 0;
    font-size: clamp(16px, 2.5vw, 36px); line-height: 1; white-space: nowrap;
    text-decoration: underline; text-decoration-color: transparent; text-decoration-thickness: 4px; text-underline-offset: 8px;
    transition: text-decoration-color var(--transicao);
  }
  .rodape__link:hover, .rodape__link[aria-current="page"] { text-decoration-color: var(--color-ousada); }
</style>
