---
// Hero: abertura da aba "A casa". Texto à esquerda (frase, chamada, botões) e, à direita, as 6 fotos do
// Instagram numa grade 3x2, como no perfil (fotos em fotos.ts → instagram). Cada foto leva ao perfil, ou a um
// post se tiver `link`. Feito à mão, sem widget nem API: não carrega nada de terceiros.
import { Icon } from 'astro-icon/components';
import Foto from './Foto.astro';
import { instagram } from '../data/fotos';
import site from '../data/site.json';
import { linkWhatsapp } from '../lib/links';

// "@bardoboni" a partir do endereço do perfil
const usuario = '@' + (site.instagram.replace(/\/+$/, '').split('/').pop() ?? 'bardoboni');
---
<section class="hero" aria-labelledby="titulo-hero">
  <div class="hero__texto">
    <h2 class="hero__titulo display" id="titulo-hero">
      <span class="hero__linha">Música <mark>ao vivo</mark></span>
      <span class="hero__linha">de quinta a domingo</span>
      <span class="hero__linha">na <mark>Lagoa da Conceição</mark></span>
    </h2>
    <p class="hero__chamada">Venha acompanhado com a família para comer uma porção ou com os amigos para tomar uma gelada, o importante é ser feliz!</p>
    <div class="hero__acoes">
      <a class="btn btn--ousada" href={linkWhatsapp()} target="_blank" rel="noopener">
        <Icon name="lucide:message-circle" aria-hidden="true" />Reservar mesa
      </a>
      <a class="btn btn--linha" href="/cardapio">
        <Icon name="lucide:utensils" aria-hidden="true" />Ver o cardápio
      </a>
    </div>
    <p class="hero__horario"><Icon name="lucide:clock" aria-hidden="true" />{site.horario.curto}</p>
  </div>

  <div class="hero__insta">
    <ul class="hero__grade" aria-label="Fotos do Instagram do Bar do Boni">
      {instagram.map((foto) => (
        <li>
          <a class="hero__foto" href={foto.link ?? site.instagram} target="_blank" rel="noopener"
            aria-label={`${foto.alt} (abre o Instagram)`}>
            <Foto foto={foto} moldura="1/1" carregamento="eager" sizes="(max-width: 899px) 33vw, 16vw" />
          </a>
        </li>
      ))}
    </ul>
    <a class="hero__perfil" href={site.instagram} target="_blank" rel="noopener">
      <Icon name="lucide:instagram" aria-hidden="true" />Siga {usuario} no Instagram
    </a>
  </div>
</section>

<style>
  .hero {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 64px; align-items: center;
    padding: 80px var(--gutter) 96px; min-height: min(calc(100svh - 80px), 900px);
  }
  .hero__texto { display: grid; gap: 32px; justify-items: start; container-type: inline-size; }
  /* Três linhas fixas, para ler melhor: "Música ao vivo" / "de quinta a domingo" / "na Lagoa da Conceição".
     Cada linha nunca quebra; a fonte acompanha a largura da coluna para a mais longa caber
     (a mais longa, com o destaque, mede 11,5em em Bricolage). A altura da linha dá espaço para as caudas
     (q, g) não encostarem no destaque da linha de baixo. */
  .hero__titulo { font-size: min(96px, 100cqi / 12.1); line-height: 1.22; text-transform: none; }
  .hero__linha { display: block; white-space: nowrap; }
  .hero__titulo mark { /* cor e animação da faixa: global.css (mark) */ padding: 0 8px .16em; /* desce para cobrir as caudas (g, ç) */ white-space: nowrap; display: inline-block; line-height: 1; }
  .hero__chamada { max-width: 40ch; font-size: 20px; text-transform: none; letter-spacing: 0; }
  .hero__acoes { display: flex; flex-wrap: wrap; gap: 16px; }
  .hero__horario { display: flex; align-items: center; gap: 8px; font-weight: 600; font-size: 16px; }
  .hero__horario :global(svg) { width: 20px; height: 20px; flex: none; }

  /* Grade 3x2 do Instagram, com a mesma junta das outras fotos */
  .hero__insta { display: grid; gap: 16px; min-width: 0; }
  .hero__grade {
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--junta);
    list-style: none; margin: 0; padding: 0;
  }
  .hero__foto { display: block; }
  .hero__foto:focus-visible { outline-offset: -3px; }
  .hero__perfil {
    justify-self: end; display: inline-flex; align-items: center; gap: 8px; font-weight: 600; font-size: 16px;
    text-decoration: underline; text-decoration-color: transparent; text-decoration-thickness: 2px; text-underline-offset: 6px;
    transition: text-decoration-color var(--transicao);
  }
  .hero__perfil:hover { text-decoration-color: var(--color-ousada); }
  .hero__perfil :global(svg) { width: 20px; height: 20px; flex: none; }

  @media (max-width: 899px) {
    .hero { grid-template-columns: minmax(0, 1fr); gap: 40px; padding: 48px var(--gutter) 56px; min-height: 0; }
    .hero__perfil { justify-self: start; }
  }
</style>
