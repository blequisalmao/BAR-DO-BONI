---
// Ornamento da casa: faixa de renda de bilro, a renda das rendeiras da Lagoa (o bar fica na Av. das Rendeiras).
// Losangos ligados por um fio, com o "pico" (pontinho) em cada encontro e uma flor no centro.
// Desenho em linha, na cor do elemento (currentColor): nos divisores da home, bege (.divisor em Casa.astro).
// Decorativo: escondido de leitores de tela.
interface Props { class?: string; altura?: number }
const { class: classe, altura = 24 } = Astro.props;
// id único por instância (o padrão SVG precisa de um id próprio em cada uso)
const id = `renda-${Math.random().toString(36).slice(2, 8)}`;
---
<svg class:list={['renda', classe]} aria-hidden="true" focusable="false" width="100%" height={altura}>
  <defs>
    <pattern id={id} width="32" height="24" patternUnits="userSpaceOnUse"
      patternTransform={`translate(0 ${(altura - 24) / 2})`}>
      <g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round">
        <!-- fio que liga os losangos -->
        <path d="M0 12H6M26 12H32" />
        <!-- losango externo e interno -->
        <path d="M16 2L26 12L16 22L6 12Z" />
        <path d="M16 7L21 12L16 17L11 12Z" />
      </g>
      <g fill="currentColor">
        <!-- flor do centro e os picos nos encontros do fio -->
        <circle cx="16" cy="12" r="1.75" />
        <circle cx="0" cy="12" r="2" />
        <circle cx="32" cy="12" r="2" />
        <circle cx="16" cy="2" r="1.25" />
        <circle cx="16" cy="22" r="1.25" />
      </g>
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill={`url(#${id})`} />
</svg>

<style>
  /* Sem viewBox: 1 unidade = 1px, então a faixa ocupa a largura toda e o desenho só se repete (nunca distorce) */
  .renda { display: block; }
</style>
