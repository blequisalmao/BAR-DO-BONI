---
// Abas fixas da página inicial: "A casa" e "Cardápio" lado a lado, presas logo abaixo do cabeçalho.
// Clicar troca o conteúdo direto para a seção escolhida, já do começo. Teclado: ← → entre as abas.
// Sem JS, as duas seções aparecem uma embaixo da outra (a barra de abas fica escondida).
interface Aba { id: string; rotulo: string; caixaAlta?: boolean }
interface Props { abas: Aba[] }
const { abas } = Astro.props;
---
<div class="abas" data-abas>
  <div class="abas__barra" role="tablist" aria-label="Seções da página">
    {abas.map((a, i) => (
      <button type="button" role="tab" class:list={['abas__aba display', { 'abas__aba--normal': !a.caixaAlta }]}
        id={`aba-${a.id}`} aria-controls={`painel-${a.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}
        data-aba={a.id}>
        {a.rotulo}
      </button>
    ))}
  </div>
  <slot />
</div>

<style>
  /* Barra dividida em duas metades, sem linhas: cada aba tem o seu fundo.
     "A casa" = fundo claro (cor base); "Cardápio" = fundo azul. A aba ativa se funde com o conteúdo,
     que assume a mesma cor de fundo (ver "tema azul" abaixo). */
  .abas__barra { display: none; }
  :global(html.js) .abas__barra {
    position: sticky; top: var(--topo-altura); z-index: 20;
    display: grid; grid-template-columns: 1fr 1fr;
  }
  .abas__aba {
    padding: 24px var(--gutter); border: 0; background: var(--color-base); color: var(--color-texto); cursor: pointer;
    font-size: clamp(20px, 3.6vw, 56px); line-height: 1; white-space: nowrap; text-align: left;
    text-transform: uppercase; /* com caixaAlta; sem ela, a aba usa a variação normal abaixo */
  }
  .abas__aba--normal { text-transform: none; }
  .abas__aba[data-aba="cardapio"] { background: var(--color-texto); color: var(--color-base); }
  .abas__aba:focus-visible { outline-offset: -6px; }
  .abas__aba[data-aba="cardapio"]:focus-visible { outline-color: var(--color-base); }
  @media (max-width: 359px) {
    .abas__aba { font-size: 18px; }
  }

  /* Tema azul: com a aba "Cardápio" aberta, a página inteira fica azul com texto claro.
     Os componentes usam as variáveis de cor, então basta invertê-las. */
  :global(html[data-aba="cardapio"] body) { background: var(--color-texto); }
  :global(#painel-cardapio) {
    --color-texto: #F1F9F9;
    --texto-suave: rgb(241 249 249 / .75);
    --texto-linha: rgb(241 249 249 / .25);
    background: #1F4E6B; color: var(--color-texto);
  }
  :global(#painel-cardapio ::selection) { background: var(--color-texto); color: #1F4E6B; }
  /* sem JS os painéis ficam todos visíveis; com JS, só o que tem .aberto (já vem certo do servidor, sem piscar) */
  :global(html.js) .abas :global([data-painel]:not(.aberto)) { display: none; }
  /* a troca de painel não deve "ancorar" a rolagem em outro ponto */
  .abas { overflow-anchor: none; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-abas]').forEach((raiz) => {
    const abas = [...raiz.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const paineis = abas.map((a) => document.getElementById(a.getAttribute('aria-controls')!)!);

    const ativar = (i: number, focar = false) => {
      abas.forEach((a, j) => {
        const ativa = i === j;
        a.setAttribute('aria-selected', String(ativa));
        a.tabIndex = ativa ? 0 : -1;
        paineis[j].classList.toggle('aberto', ativa);
      });
      document.documentElement.dataset.aba = abas[i].dataset.aba;
      if (focar) abas[i].focus();
      // a seção escolhida começa do início, logo abaixo das abas
      scrollTo(0, 0);
      requestAnimationFrame(() => scrollTo(0, 0));
    };

    // estado inicial: só o primeiro painel aberto
    paineis.forEach((p, j) => { p.setAttribute('role', 'tabpanel'); p.setAttribute('aria-labelledby', abas[j].id); p.classList.toggle('aberto', j === 0); });
    document.documentElement.dataset.aba = abas[0].dataset.aba;

    abas.forEach((a, i) => {
      a.addEventListener('click', () => ativar(i));
      a.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') { e.preventDefault(); ativar((i + 1) % abas.length, true); }
        if (e.key === 'ArrowLeft') { e.preventDefault(); ativar((i - 1 + abas.length) % abas.length, true); }
      });
    });

    // Botões dentro do conteúdo que trocam de aba (ex.: "Ver o cardápio completo" em A casa)
    raiz.querySelectorAll<HTMLElement>('[data-ir-aba]').forEach((b) => {
      b.addEventListener('click', () => {
        const i = abas.findIndex((a) => a.dataset.aba === b.dataset.irAba);
        if (i >= 0) ativar(i, true);
      });
    });

    // Altura da barra de abas: a rolagem até uma seção (ex.: #avaliacoes) para logo abaixo dela
    const barra = raiz.querySelector<HTMLElement>('[role="tablist"]')!;
    const medir = () => document.documentElement.style.setProperty('--abas-altura', `${barra.offsetHeight}px`);
    medir();
    addEventListener('resize', medir);

    // Âncora para uma seção dentro de um painel (ex.: link "Avaliações" do rodapé → /#avaliacoes):
    // abre a aba certa e rola até a seção, sem deixar o "#..." no endereço
    const irPara = (id: string) => {
      const alvo = id ? document.getElementById(id) : null;
      const painel = alvo?.closest<HTMLElement>('[data-painel]');
      if (!alvo || !painel) return false;
      abas.forEach((a, j) => {
        const ativa = paineis[j] === painel;
        a.setAttribute('aria-selected', String(ativa));
        a.tabIndex = ativa ? 0 : -1;
        paineis[j].classList.toggle('aberto', ativa);
        if (ativa) document.documentElement.dataset.aba = a.dataset.aba;
      });
      requestAnimationFrame(() => alvo.scrollIntoView({ block: 'start' }));
      return true;
    };
    // vindo de outra página: o Base.astro guarda a âncora em data-ancora e limpa o endereço
    const inicial = document.documentElement.dataset.ancora;
    if (inicial) {
      delete document.documentElement.dataset.ancora;
      const rolar = () => irPara(inicial);
      if (document.readyState === 'complete') rolar(); else addEventListener('load', rolar, { once: true });
      // a tela de carregamento (1ª visita) muda a altura da página ao sair: rola de novo
      addEventListener('boni:pronto', () => setTimeout(rolar, 50), { once: true });
    }
    // já na página inicial: o clique no link do rodapé só troca o "#"
    addEventListener('hashchange', () => {
      if (irPara(location.hash.slice(1))) history.replaceState(null, '', location.pathname + location.search);
    });
  });
</script>
