---
// Cabeçalho fixo e sempre visível: a logo do Bar do Boni (PNG) e o botão de reservar.
// Fundo claro: o azul oficial a 14% sobre a cor base (tom intermediário da paleta), a 95% de opacidade,
// para a logo (barco azul e linha "Lagoa da Conceição") aparecer bem.
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { imagem } from '../lib/imagens';
import { linkWhatsapp } from '../lib/links';
---
<header class="topo">
  <a class="topo__marca" href="/">
    <Image class="topo__logo" src={imagem('logo_bar_do_boni.png')} alt="Bar do Boni, ir para o início"
      widths={[150, 300]} sizes="96px" format="png" loading="eager" />
  </a>
  <a class="btn btn--ousada" href={linkWhatsapp()} target="_blank" rel="noopener">
    <Icon name="lucide:message-circle" aria-hidden="true" />Reservar
  </a>
</header>

<style>
  .topo {
    position: fixed; inset: 0 0 auto 0; z-index: 30; height: var(--topo-altura);
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    padding: 0 var(--gutter);
    background: rgb(212 225 229 / .95); color: var(--color-texto);
    border-bottom: 2px solid var(--color-texto);
  }
  .topo :focus-visible { outline-color: var(--color-texto); }
  .topo__marca { display: block; flex: none; line-height: 0; }
  /* Logo em PNG, na proporção natural (425 × 259) */
  .topo :global(.topo__logo) { display: block; width: auto; height: 56px; }
  @media (max-width: 599px) { .topo :global(.topo__logo) { height: 48px; } }
  @media (max-width: 359px) {
    .topo { gap: 8px; }
    .topo .btn { padding-inline: 8px; }
    .topo .btn :global(svg) { display: none; }
  }
</style>
