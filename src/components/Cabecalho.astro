---
// Cabeçalho fixo e sempre visível: a logo, o menu de navegação, as redes e o botão de reservar.
// Fundo claro: o amarelo do site (#F3B416), a 97% de opacidade; ali o CTA "Reservar" fica azul,
// para a logo (barco azul e linha "Lagoa da Conceição") aparecer bem.
// Desktop (≥ 1024px): links em linha. Menor que isso: botão "Menu" abre um painel com os links grandes.
// O link "Agenda" (/#agenda) leva à seção da agenda na página inicial.
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { imagem } from '../lib/imagens';
import { linkWhatsapp } from '../lib/links';
import site from '../data/site.json';

const links = [
  { href: '/', texto: 'Início' },
  { href: '/cardapio', texto: 'Cardápio' },
  { href: '/#agenda', texto: 'Agenda' },
  { href: '/galeria', texto: 'Galeria' },
  { href: '/contato', texto: 'Contato' },
];
const atual = Astro.url.pathname.replace(/\/$/, '') || '/';
const redes = [
  { href: site.instagram, nome: 'Instagram', icone: 'lucide:instagram' },
  { href: site.facebook, nome: 'Facebook', icone: 'lucide:facebook' },
];
---
<header class="topo" data-topo>
  <a class="topo__marca" href="/">
    <Image class="topo__logo" src={imagem('logo_bar_do_boni.png')} alt="Bar do Boni, ir para o início"
      widths={[150, 300]} sizes="96px" format="png" loading="eager" />
  </a>

  <nav class="topo__nav" aria-label="Principal">
    <ul class="topo__links" id="menu-principal" data-menu>
      {links.map((l) => (
        <li>
          <a class="topo__link" href={l.href} aria-current={atual === l.href ? 'page' : undefined}>{l.texto}</a>
        </li>
      ))}
      <li class="topo__redes-menu">
        {redes.map((r) => (
          <a class="link" href={r.href} target="_blank" rel="noopener">{r.nome}</a>
        ))}
      </li>
    </ul>
  </nav>

  <div class="topo__acoes">
    <ul class="topo__redes">
      {redes.map((r) => (
        <li>
          <a class="topo__rede" href={r.href} target="_blank" rel="noopener" aria-label={`${r.nome} do Bar do Boni`}>
            <Icon name={r.icone} aria-hidden="true" />
          </a>
        </li>
      ))}
    </ul>
    <a class="btn btn--ousada" href={linkWhatsapp()} target="_blank" rel="noopener">
      <Icon name="lucide:message-circle" aria-hidden="true" />Reservar
    </a>
    <button class="topo__menu" type="button" aria-controls="menu-principal" aria-expanded="false" data-abrir-menu hidden>
      <Icon name="lucide:menu" class="topo__icone-abrir" aria-hidden="true" />
      <Icon name="lucide:x" class="topo__icone-fechar" aria-hidden="true" />
      <span class="sr-only">Menu</span>
    </button>
  </div>
</header>

<style>
  .topo {
    position: fixed; inset: 0 0 auto 0; z-index: 30; height: var(--topo-altura);
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
    padding: 0 var(--gutter);
    /* o cabeçalho continua amarelo com texto azul (inverte os papéis de cor só aqui dentro, menu do celular incluído) */
    --color-base: var(--amarelo); --color-texto: var(--azul); --color-ousada: var(--azul);
    --texto-linha: rgb(62 99 119 / .3);
    background: rgb(243 180 22 / .97); color: var(--color-texto);
    border-bottom: 2px solid var(--color-texto);
  }
  .topo :focus-visible { outline-color: var(--color-texto); }
  .topo__marca { display: block; flex: none; line-height: 0; }
  /* Logo em PNG, na proporção natural (425 × 259) */
  .topo :global(.topo__logo) { display: block; width: auto; height: 56px; }

  /* Links: Bricolage Grotesque (--font-display), só o sublinhado amarelo muda no hover e na página atual */
  .topo__links { display: flex; align-items: center; gap: 32px; list-style: none; margin: 0; padding: 0; }
  .topo__link {
    font: 800 18px/1 var(--font-display); letter-spacing: .02em; text-decoration: underline;
    text-decoration-color: transparent; text-decoration-thickness: 3px; text-underline-offset: 8px;
    transition: text-decoration-color var(--transicao);
  }
  .topo__link:hover, .topo__link[aria-current="page"] { text-decoration-color: var(--color-ousada); }
  .topo__redes-menu { display: none; }

  .topo__acoes { display: flex; align-items: center; gap: 16px; flex: none; }
  .topo__redes { display: flex; gap: 8px; list-style: none; margin: 0; padding: 0; }
  .topo__rede {
    width: 40px; height: 40px; display: grid; place-items: center; color: var(--color-texto);
    border: 2px solid transparent; transition: border-color var(--transicao);
  }
  .topo__rede:hover { border-color: var(--color-texto); }
  .topo__rede :global(svg) { width: 22px; height: 22px; }

  .topo__menu {
    width: 48px; height: 48px; display: grid; place-items: center; padding: 0;
    background: transparent; color: var(--color-texto); border: 2px solid var(--color-texto); cursor: pointer;
    transition: background-color var(--transicao), color var(--transicao);
  }
  .topo__menu:hover { background: var(--color-texto); color: var(--color-base); }
  .topo__menu :global(svg) { width: 24px; height: 24px; }
  .topo__menu :global(.topo__icone-fechar), .topo__menu[aria-expanded="true"] :global(.topo__icone-abrir) { display: none; }
  .topo__menu[aria-expanded="true"] :global(.topo__icone-fechar) { display: block; }

  /* Tablet e celular: menu num painel que desce do cabeçalho */
  @media (max-width: 1023px) {
    .topo__redes { display: none; }
    /* sem JS, o menu fica escondido e o rodapé tem todos os links */
    .topo__links { display: none; }
    :global(html.js) .topo__links[data-aberto] {
      position: fixed; inset: var(--topo-altura) 0 auto 0; z-index: 29;
      max-height: calc(100svh - var(--topo-altura)); overflow-y: auto;
      display: grid; gap: 0; justify-items: start;
      padding: 16px var(--gutter) 32px; background: var(--color-base); border-bottom: 2px solid var(--color-texto);
    }
    .topo__links[data-aberto] .topo__link { display: inline-block; padding: 16px 0; font-size: clamp(28px, 7vw, 48px); text-transform: none; }
    .topo__links[data-aberto] .topo__redes-menu { display: flex; gap: 24px; padding-top: 16px; text-transform: none; letter-spacing: 0; font-weight: 600; }
  }
  @media (max-width: 599px) { .topo :global(.topo__logo) { height: 48px; } .topo { gap: 8px; } .topo__acoes { gap: 8px; } }
  @media (max-width: 359px) {
    .topo .btn { padding-inline: 8px; }
    .topo .btn :global(svg) { display: none; }
  }
</style>

<script>
  const botao = document.querySelector<HTMLButtonElement>('[data-abrir-menu]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  if (botao && menu) {
    const telaGrande = matchMedia('(min-width: 1024px)');
    const mostrarBotao = () => { botao.hidden = telaGrande.matches; if (telaGrande.matches) fechar(); };
    const abrir = () => { menu.dataset.aberto = ''; botao.setAttribute('aria-expanded', 'true'); };
    function fechar() { delete menu!.dataset.aberto; botao!.setAttribute('aria-expanded', 'false'); }
    botao.addEventListener('click', () => (menu.hasAttribute('data-aberto') ? fechar() : abrir()));
    // clicar num link fecha o painel (os links com "#" ficam na mesma página)
    menu.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) fechar(); });
    addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.hasAttribute('data-aberto')) { fechar(); botao.focus(); }
    });
    telaGrande.addEventListener('change', mostrarBotao);
    mostrarBotao();
  }
</script>
